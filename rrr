
use LibraryDB

db.createCollection("books", {
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["isbn", "title", "authorId"],
            properties: {
                isbn: { bsonType: "string" },
                title: { bsonType: "string" },
                authorId: { bsonType: "int" }
            }
        }
    }
})

db.createCollection("members", {
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["memberId", "name", "age"],
            properties: {
                memberId: { bsonType: "int" },
                name: { bsonType: "string" },
                age: { bsonType: "int", minimum: 5, maximum: 100 }
            }
        }
    }
})

db.createCollection("borrowRecords", {
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["recordId", "memberId", "isbn", "borrowDate", "returnDate"],
            properties: {
                recordId: { bsonType: "int" },
                memberId: { bsonType: "int" },
                isbn: { bsonType: "string" },
                borrowDate: { bsonType: "date" },
                returnDate: { bsonType: "date" }
            }
        }
    }
})

db.createCollection("authors", {
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["authorId", "name"],
            properties: {
                authorId: { bsonType: "int" },
                name: { bsonType: "string" }
            }
        }
    }
})

