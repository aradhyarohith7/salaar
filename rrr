 name: { bsonType: "string" },
 category: { bsonType: "string" },
 price: { bsonType: "double" },
 expiryDate: { bsonType: "date" }
 }
 }
 }
})
//Prescriptions Collection
db.createCollection("prescriptions", {
 validator: {
 $jsonSchema: {
